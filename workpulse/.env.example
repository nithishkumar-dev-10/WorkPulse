# Copy to workpulse/.env and fill in your own values. Never commit the real .env.

# Neon Postgres connection string (SQLAlchemy + psycopg driver). SSL is enforced in code.
DATABASE_URL=

# Put any origin that hosts the frontend here (comma-separated extras via CORS_ORIGINS).
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Localhost dev ports are allowed by the regex below even when Vite
# falls back to 5174, 5175, etc. Leave these commented to use the defaults.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7

# development | production — production forces Secure cookies.
ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Feature flag used by the existing API.
ENABLE_EXPLAIN=true
